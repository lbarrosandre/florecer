{
  "name": "florescer",
  "version": "0.3.0",
  "private": true,
  "description": "Florescer — diário de bem-estar (app Android via Capacitor)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "serve": "python -m http.server 8000 --bind 127.0.0.1",
    "cap:sync": "npm run build && npx cap sync android && npm run check:android",
    "check:android": "node scripts/check-android-plugins.mjs",
    "cap:open": "npx cap open android",
    "teste:regras": "firebase emulators:exec --only firestore --project florescer-teste-regras \"node tests/regras.mjs\""
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.1",
    "@capgo/capacitor-native-biometric": "^8.6.11",
    "firebase-admin": "^14.4.0",
    "jspdf": "^4.2.1",
    "resend": "^6.28.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.30.2"
  }
}
