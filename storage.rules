rules_version = '2';

// Regras do Firebase Storage — projeto florecer-app-c460d
// Único uso hoje: foto de perfil em avatars/{uid}/avatar.jpg

service firebase.storage {
  match /b/{bucket}/o {

    match /avatars/{uid}/{file} {
      // A foto de perfil pode ser lida por qualquer usuário autenticado
      // (o link de download já carrega um token; manter simples).
      allow read: if request.auth != null;

      // Só o dono grava a própria foto: imagem, no máximo 3 MB.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 3 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Qualquer outro caminho é negado por padrão.
  }
}
